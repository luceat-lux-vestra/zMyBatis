<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fixture.PendingCommonMapperDeclarations">

    <!-- R03-R05 are NOT release PASS cases while #510 is open.
         These reproduce ordinary mapper declarations from the historical mybatisTest project. -->
    <resultMap id="ProductResultMap" type="fixture.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="active" column="active"/>
    </resultMap>

    <select id="findAllWithResultMap" resultMap="ProductResultMap">
        SELECT id, name, active
        FROM products
        ORDER BY id
    </select>

    <select id="findAllWithResultType" resultType="fixture.Product">
        SELECT id, name, active
        FROM products
        ORDER BY id
    </select>

    <select id="findByIdWithParameterType" parameterType="long">
        SELECT id, name, active
        FROM products
        WHERE id = #{id,jdbcType=BIGINT}
    </select>

</mapper>
