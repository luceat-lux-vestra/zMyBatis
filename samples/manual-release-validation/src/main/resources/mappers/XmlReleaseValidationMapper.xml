<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fixture.XmlReleaseValidationMapper">

    <!-- M01: DB-neutral zero-binding golden path. -->
    <select id="zeroBinding" resultType="long">
        SELECT 7 AS result_value
    </select>

    <!-- M03: maintained nonzero production slice: exactly one PostgreSQL BIGINT binding. -->
    <select id="bigintEcho" resultType="long">
        SELECT #{value,jdbcType=BIGINT}::BIGINT AS result_value
    </select>

    <!-- M04: canonical E2E BIGINT + stock-MyBatis Boolean-if path. -->
    <select id="bigintWithIf" resultType="long">
        SELECT #{value,jdbcType=BIGINT}::BIGINT AS result_value
        <if test="value > 0">
            , 1::BIGINT AS positive_marker
        </if>
    </select>

    <!-- M05: bounded WHERE + Boolean-if wrapper. -->
    <select id="whereIf" resultType="long">
        SELECT id
        FROM products
        <where>
            <if test="enabled">
                AND id = #{id,jdbcType=BIGINT}
            </if>
        </where>
        ORDER BY id
    </select>

    <!-- M06: source-proven foreach. [1] can stay inside the one-BIGINT materializer envelope;
         [1,2] must fail closed because two nonzero bindings are outside that envelope. -->
    <select id="foreachIds" resultType="long">
        SELECT id
        FROM products
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id,jdbcType=BIGINT}
        </foreach>
        ORDER BY id
    </select>

    <!-- M07: raw interpolation must require explicit raw acknowledgement and final preview. -->
    <select id="rawEcho" resultType="long">
        SELECT ${value} AS result_value
    </select>

    <!-- M08: target-derived standard MyBatis databaseId selection. -->
    <select id="databaseIdEcho" resultType="long">
        SELECT 2600 AS result_value
    </select>
    <select id="databaseIdEcho" databaseId="PostgreSQL" resultType="long">
        SELECT 2620 AS result_value
    </select>

    <!-- M09: VARCHAR binding is deliberately outside the maintained PostgreSQL BIGINT slice. -->
    <select id="unsupportedVarchar" resultType="string">
        SELECT #{value,jdbcType=VARCHAR} AS result_value
    </select>

    <!-- M10: two BIGINT bindings are deliberately outside the one-binding materializer slice. -->
    <select id="unsupportedTwoBigints" resultType="long">
        SELECT #{left,jdbcType=BIGINT}::BIGINT + #{right,jdbcType=BIGINT}::BIGINT AS result_value
    </select>

    <!-- M11-M13: safe mutation declarations. All must force final-artifact confirmation. -->
    <insert id="insertNoop">
        INSERT INTO release_probe (id, note)
        SELECT 9002, 'xml-noop'
        WHERE FALSE
    </insert>

    <update id="updateNoop">
        UPDATE products
        SET active = active
        WHERE FALSE
    </update>

    <delete id="deleteNoop">
        DELETE FROM products
        WHERE FALSE
    </delete>

</mapper>
