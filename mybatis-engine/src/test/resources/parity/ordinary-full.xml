<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="parity.OrdinaryFull">
    <cache/>

    <resultMap id="ProductMap" type="com.algorist.zMyBatis.mybatis.parity.HistoricalProduct">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="active" column="active"/>
    </resultMap>

    <select id="withResultMap" parameterType="map" resultMap="ProductMap">
        SELECT id, name, active
        FROM products
        WHERE id = #{id,jdbcType=BIGINT}
    </select>

    <select id="withResultType" parameterType="map" resultType="map">
        SELECT id, name
        FROM products
        WHERE name = #{name,jdbcType=VARCHAR}
    </select>
</mapper>
