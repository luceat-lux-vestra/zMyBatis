<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.algorist.zMyBatis</id>
    <name>zMyBatis</name>
    <vendor url="https://github.com/luceat-lux-vestra" email="heathkimdev@gmail.com">algorist</vendor>

    <!-- Plugin description and change-notes are injected at build time by Gradle (patchPluginXml / intellijPlatform.changeNotes) -->
    <description><![CDATA[zMyBatis evaluates MyBatis dynamic SQL inside the IDE and executes it in DataGrip. ${pluginDescription}]]></description>
    <change-notes><![CDATA[${changeNotes}]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <depends>com.intellij.database</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- <toolWindow factoryClass="com.github.luceatluxvestra.zmybatisprivate.toolWindow.MyToolWindowFactory" id="MyToolWindow"/> -->
        <!-- <postStartupActivity implementation="com.github.luceatluxvestra.zmybatisprivate.startup.MyProjectActivity" /> -->
        <postStartupActivity implementation="com.algorist.zMyBatis.startup.MyBatisActionInterceptorActivity"/>

        <!-- ConsoleCacheService and ParameterHistoryService are annotated with @Service in code; do not register them here. -->

        <!-- Settings -->
        <applicationService serviceImplementation="com.algorist.zMyBatis.settings.ZMyBatisSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.algorist.zMyBatis.settings.ZMyBatisConfigurable"
            id="com.algorist.zMyBatis.settings.ZMyBatisConfigurable"
            displayName="zMyBatis - Dynamic SQL Runner with Parameters"/>
    </extensions>

    <actions>
        <!--
            Declarative overrides: MyBatisExecuteProxyAction replaces each target DB console
            action at plugin load time — no runtime replaceAction() call needed.

            The original action ID is reused as-is with overrides="true". The platform
            substitutes our class for the original at load time while preserving the action's
            existing shortcuts, menu position, and icon.

            When update() returns isEnabledAndVisible=false (non-MyBatis context) the platform
            automatically falls back to the original action, so normal SQL console behaviour
            is fully preserved.
        -->
        <action id="Console.Jdbc.Execute"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Execute"
                overrides="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <action id="Console.Jdbc.ExplainPlan"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Explain Plan"
                overrides="true"/>

        <action id="Console.Jdbc.ExplainPlan.Raw"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Explain Plan (Raw)"
                overrides="true"/>

        <action id="Console.Jdbc.ExplainAnalyse"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Explain Analyse"
                overrides="true"/>

        <action id="Console.Jdbc.ExplainAnalyse.Raw"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Explain Analyse (Raw)"
                overrides="true"/>

        <action id="Console.TableResult.ShowDumpDialogAction"
                class="com.algorist.zMyBatis.MyBatisExecuteProxyAction"
                text="Export Data"
                overrides="true"/>
    </actions>
</idea-plugin>
